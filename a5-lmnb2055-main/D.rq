PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX ncv: <http://n2t.net/ark:/39333/ncg/vocab#>

# places in the same county as Choggy Butte Mountain
SELECT ?name WHERE {
    ?mountain skos:prefLabel ?label .
    FILTER( LCASE(STR(?label)) = "choggy butte mountain" )

    ?mountain ncv:county ?county .
    ?county skos:prefLabel ?county_name .

    ?place ncv:county ?county .
    ?place skos:prefLabel ?name .

}

ORDER BY LCASE(STR(?placeName))  