PREFIX :     <http://example.org/sils#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

:ae     rdf:type    :Sourcetype;
        rdfs:label  "apache:error"@en .

:aa     rdf:type    :Sourcetype;
        rdfs:label  "apache:access"@en .

:ps     rdf:type    :Sourcetype;
        rdfs:label  "postfix_syslog"@en .

:dmesg  rdf:type    :Sourcetype;
        rdfs:label  "dmesg"@en .

:ls     rdf:type    :Sourcetype;
        rdfs:label  "linux_secure"@en .

:lms    rdf:type    :Sourcetype;
        rdfs:label  "linux_messages_syslog"@en .

:shibboleth  rdf:type  :LogGroup;
        rdfs:label  "Shibboleth Logs"@en .

:vault  rdf:type    :LogGroup;
        rdfs:label  "Vault Logs"@en .

:php    rdf:type       :LogGroup;
        rdfs:label     "PHP Logs"@en;
        :beSourcetype  :ls .

:apache  rdf:type      :LogGroup;
        rdfs:label     "Apache Logs"@en;
        :beSourcetype  :ae , :aa .

:database  rdf:type    :LogGroup;
        rdfs:label     "Database Logs"@en;
        :beSourcetype  :ls .

:puppet  rdf:type      :LogGroup;
        rdfs:label     "Puppetlab Logs"@en;
        :beSourcetype  :ls .

:audit  rdf:type       :LogGroup;
        rdfs:label     "File Audit Logs"@en;
        :beSourcetype  :ls .

:zabbix  rdf:type      :LogGroup;
        rdfs:label     "Zabbix Logs"@en;
        :beSourcetype  :ls .

:sudologs  rdf:type    :LogGroup;
        rdfs:label     "Sudo Logs"@en;
        :beSourcetype  :ls .

:maillogs  rdf:type    :LogGroup;
        rdfs:label     "Mail Logs"@en;
        :beSourcetype  :ps .

:packagemanagementlogs
        rdf:type       :LogGroup;
        rdfs:label     "Package Management Logs"@en;
        :beSourcetype  :lms .

:kerlogs  rdf:type     :LogGroup;
        rdfs:label     "Kernel Logs"@en;
        :beSourcetype  :lms .

:diagmsglogs  rdf:type  :LogGroup;
        rdfs:label     "Diagnostic Messages Logs"@en;
        :beSourcetype  :dmesg .

:autlogs  rdf:type     :LogGroup;
        rdfs:label     "Authentication Logs"@en;
        :beSourcetype  :ls .

:syslogs  rdf:type     :LogGroup;
        rdfs:label     "System Logs"@en;
        :beSourcetype  :lms .

:app    rdf:type      :Category;
        rdfs:label    "Application-related"@en;
        :hasLogGroup  :shibboleth , :vault , :php , :apache , :database , :puppet , :audit , :zabbix .

:sys    rdf:type      :Category;
        rdfs:label    "System-related"@en;
        :hasLogGroup  :sudologs , :maillogs , :packagemanagementlogs , :kerlogs , :diagmsglogs , :autlogs , :syslogs .

:sils   rdf:type      :Index;
        rdfs:label    "SILS Index"@en;
        :categorizes  :app , :sys .
